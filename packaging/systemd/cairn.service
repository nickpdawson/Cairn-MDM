[Unit]
Description=Cairn MDM server
Documentation=https://github.com/dzsec/cairn-mdm
After=network-online.target
Wants=network-online.target

[Service]
User=cairn
Group=cairn
ExecStart=/usr/local/bin/cairn serve --config /etc/cairn/cairn.toml
Restart=on-failure
RestartSec=5

# Hardening. The DB holds the CA/APNs keys and session tokens, so keep the
# process locked down and the umask tight (0600 files).
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/cairn
# Binding :443 directly (not behind a proxy) needs this; harmless otherwise.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
